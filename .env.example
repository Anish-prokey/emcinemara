# Copy to .env and paste your own key. .env is gitignored and must stay that way.
# Do NOT paste a real key into THIS file - it is committed to the repository.
#
# TMDB gives you two credentials. Either works - the fetcher detects which:
#   TMDB_KEY  = the v3 API Key   (32 hex characters)
#   TMDB_KEY  = the v4 Read Access Token (a long JWT with two dots)
#
# Get them at https://www.themoviedb.org/settings/api
TMDB_KEY=your_key_here
